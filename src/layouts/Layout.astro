---
import Navbar from "@components/layout/Navbar.astro";
import Footer from "@components/layout/Footer.astro";
import SeoHead from "@components/layout/SeoHead.astro";
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/inter";
import "@fontsource-variable/geist-mono";
import "@styles/global.css";
import { resolveSeo, type SchemaValue } from "@lib/seo";

interface Props {
  title?: string | undefined;
  seoTitle?: string | undefined;
  description?: string | undefined;
  seoDescription?: string | undefined;
  image?: string | null | undefined;
  imageAlt?: string | undefined;
  imageWidth?: number | undefined;
  imageHeight?: number | undefined;
  imageType?: string | undefined;
  canonical?: string | undefined;
  noindex?: boolean | undefined;
  robots?: string | undefined;
  type?: "website" | "article" | "profile" | undefined;
  structuredData?: SchemaValue | SchemaValue[] | undefined;
  lang?: string | undefined;
  fixedNavbar?: boolean | undefined;
  publishedTime?: Date | string | undefined;
  modifiedTime?: Date | string | undefined;
  section?: string | undefined;
  tags?: string[] | undefined;
}

const {
  title,
  seoTitle,
  description,
  seoDescription,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  imageType,
  canonical,
  noindex = false,
  robots,
  type = "website",
  structuredData,
  lang = "en",
  fixedNavbar = true,
  publishedTime,
  modifiedTime,
  section,
  tags = [],
} = Astro.props as Props;

const seo = resolveSeo({
  title,
  seoTitle,
  description,
  seoDescription,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  imageType,
  canonical,
  noindex,
  robots,
  type,
  pathname: Astro.url.pathname,
  publishedTime,
  modifiedTime,
  section,
  tags,
});

const schemaItems: SchemaValue[] = Array.isArray(structuredData) ? structuredData : structuredData ? [structuredData] : [];
---

<!doctype html>
<html lang={lang}>
  <head>
    <ClientRouter />
    <SeoHead seo={seo} structuredData={schemaItems} />

    <script is:inline>
      // Runs before first paint, and again around every client-side navigation,
      // so the page never flashes the wrong theme.
      (() => {
        const isDark = () => {
          try {
            const saved = localStorage.getItem("darkMode");
            if (saved) return saved === "true";
          } catch {}
          return window.matchMedia("(prefers-color-scheme: dark)").matches;
        };
        const apply = (doc) => doc.documentElement.classList.toggle("dark", isDark());

        apply(document);
        if (window.__themeListeners) return;
        window.__themeListeners = true;
        document.addEventListener("astro:before-swap", (event) => apply(event.newDocument));
        document.addEventListener("astro:after-swap", () => apply(document));
      })();
    </script>
  </head>
  <body class="font-sans">
    <!-- The address is already public (structured data, llms.txt), and Cloudflare's email
         obfuscation would inject a render-blocking decoder script into every page. -->
    <Fragment set:html="<!--email_off-->" />
    {fixedNavbar ? <div aria-hidden="true" class="h-14"></div> : null}
    <header>
      <Navbar fixed={fixedNavbar} />
    </header>
    <main>
      <slot />
    </main>
    <Footer />
    <Fragment set:html="<!--/email_off-->" />

    <script>
      import "@scripts/scroll-direction";
      import "@scripts/image-zoom";
    </script>
  </body>
</html>
