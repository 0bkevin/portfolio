---
import TocList from "./TocList.astro";
import type { TocEntry } from "./toc";

interface Props {
  entries: readonly TocEntry[];
}

const { entries } = Astro.props;
---

<!-- Desktop: a slim rail on the left that expands on hover or focus. -->
<div class="toc-rail fixed left-6 top-24 z-40 hidden xl:block">
  <nav
    class="toc-panel relative h-[calc(100vh-7rem)] max-h-[520px] w-12 overflow-hidden rounded-r-lg border-l border-surface-200/80 bg-[#fafafa]/70 py-3 shadow-sm backdrop-blur-md transition-all duration-300 ease-out focus-within:w-[300px] focus-within:border-surface-200 focus-within:bg-[#fafafa]/95 focus-within:px-4 focus-within:shadow-lg hover:w-[300px] hover:border-surface-200 hover:bg-[#fafafa]/95 hover:px-4 hover:shadow-lg dark:border-surface-800/80 dark:bg-[#0a0a0a]/55 dark:focus-within:border-surface-800 dark:focus-within:bg-[#0a0a0a]/88 dark:hover:border-surface-800 dark:hover:bg-[#0a0a0a]/88"
    aria-label="Table of contents"
  >
    <div class="toc-tab flex h-full min-h-32 w-12 flex-col items-center justify-start gap-3 text-surface-500 transition-opacity duration-200">
      <span class="mt-1 h-9 w-px rounded-full bg-surface-300 dark:bg-surface-700"></span>
      <span class="toc-vertical font-mono text-[10px] lowercase tracking-wider">contents</span>
    </div>

    <div class="toc-content absolute inset-y-0 left-0 w-[300px] opacity-0 transition-opacity duration-200">
      <div class="h-full overflow-y-auto p-4 pb-7 pl-5">
        <p class="mb-3 font-mono text-[12px] lowercase text-surface-500"><span class="text-accent-500 dark:text-accent-400">//</span> contents</p>
        <TocList entries={entries} />
      </div>
      <div class="toc-fade pointer-events-none absolute inset-x-0 bottom-0 h-12"></div>
    </div>
  </nav>
</div>

<!-- Phones and tablets: a floating button that opens the list as a panel. -->
<button
  type="button"
  data-toc-open
  aria-label="Open table of contents"
  aria-expanded="false"
  aria-controls="mobile-toc"
  class="float-chrome fixed bottom-5 left-5 z-40 inline-flex items-center gap-2 rounded-md border border-surface-200/80 bg-[#fafafa]/90 px-3 py-2 font-mono text-[12px] lowercase text-surface-500 shadow-sm backdrop-blur hover:border-surface-300 hover:text-surface-900 focus:outline-none focus:ring-1 focus:ring-surface-300 dark:border-surface-800/80 dark:bg-[#0a0a0a]/85 dark:text-surface-400 dark:hover:border-surface-700 dark:hover:text-surface-100 dark:focus:ring-surface-700 xl:hidden"
>
  <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-accent-500 dark:bg-accent-400"></span>
  contents
</button>

<div data-toc-mobile class="fixed inset-0 z-50 hidden xl:hidden">
  <button
    type="button"
    data-toc-close
    class="absolute inset-0 h-full w-full bg-surface-950/20 backdrop-blur-[1px] dark:bg-[#0a0a0a]/55"
    aria-label="Close table of contents"
  ></button>

  <nav
    id="mobile-toc"
    class="absolute inset-x-4 bottom-4 mx-auto max-h-[70vh] max-w-xl overflow-hidden rounded-md border border-surface-200/80 bg-[#fafafa] shadow-xl dark:border-surface-800/80 dark:bg-[#0a0a0a]"
    aria-label="Table of contents"
  >
    <div class="max-h-[70vh] overflow-y-auto p-4 pb-7">
      <div class="mb-3 flex items-center justify-between gap-4">
        <p class="font-mono text-[12px] lowercase text-surface-500"><span class="text-accent-500 dark:text-accent-400">//</span> contents</p>
        <button
          type="button"
          data-toc-close
          class="font-mono text-[12px] lowercase text-surface-500 transition-colors hover:text-surface-900 dark:hover:text-surface-200"
        >
          close
        </button>
      </div>
      <TocList entries={entries} />
    </div>
    <div class="toc-fade pointer-events-none absolute inset-x-0 bottom-0 h-12"></div>
  </nav>
</div>

<script>
  import { initTableOfContents } from "@scripts/table-of-contents";

  initTableOfContents();
</script>

<style>
  .toc-vertical {
    writing-mode: vertical-rl;
    text-orientation: mixed;
  }

  .toc-panel:hover .toc-tab,
  .toc-panel:focus-within .toc-tab {
    opacity: 0;
    pointer-events: none;
  }

  .toc-panel:hover .toc-content,
  .toc-panel:focus-within .toc-content {
    opacity: 1;
  }

  .toc-fade {
    background: linear-gradient(to bottom, transparent, rgba(250, 250, 250, 0.98));
    box-shadow: inset 0 -14px 22px rgba(250, 250, 250, 0.82);
  }

  :global(.dark) .toc-fade {
    background: linear-gradient(to bottom, transparent, rgba(10, 10, 10, 0.98));
    box-shadow: inset 0 -14px 22px rgba(10, 10, 10, 0.86);
  }
</style>
