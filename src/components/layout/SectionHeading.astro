---
interface Props {
  /** Optional section number, e.g. "03". Without it the label reads "// label". */
  num?: string;
  label: string;
}

const { num, label } = Astro.props;
---

<p class="section-heading">
  <span>
    <span class="section-num" aria-hidden="true">// {num}</span>
    {num && <span aria-hidden="true">·</span>}
    {label}
  </span>
</p>
