---
import Icon from "@components/ui/Icon.astro";
import { NAV_ITEMS } from "@data/navigation";
import { PROFILE_LINKS } from "@data/profile";

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-surface-200 font-mono dark:border-surface-800">
  <div class="home-col py-6">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex flex-col items-center gap-3 sm:flex-row sm:gap-6">
        <a href="/" class="text-sm font-semibold tracking-tight text-surface-900 dark:text-surface-100">
          kevin bravo
        </a>
        <nav class="flex flex-wrap justify-center gap-x-5 gap-y-2" aria-label="Footer navigation">
          {
            NAV_ITEMS.map(({ label, href }) => (
              <a
                href={href}
                class="text-xs lowercase text-surface-500 hover:text-surface-900 dark:hover:text-surface-200 transition-colors"
              >
                {label}
              </a>
            ))
          }
        </nav>
      </div>

      <div class="flex items-center gap-6">
        <div class="flex gap-4">
          {
            PROFILE_LINKS.map(({ icon, href, label }) => (
              <a
                target="_blank"
                href={href}
                rel="noopener noreferrer"
                aria-label={label}
                class="text-surface-500 transition-colors hover:text-surface-900 dark:hover:text-surface-200"
              >
                <Icon name={icon} class="h-4 w-4" />
              </a>
            ))
          }
        </div>
        <span class="text-xs text-surface-500">
          &copy; {currentYear}
        </span>
      </div>
    </div>
  </div>
</footer>
