---
import ThemeToggle from "@components/layout/ThemeToggle.astro";
import { NAV_ITEMS, activeNavHref } from "@data/navigation";

interface Props {
  /** Fixed navbars float over the page and hide while scrolling down; articles use a static one. */
  fixed?: boolean;
}

const { fixed = true } = Astro.props;
const active = activeNavHref(Astro.url.pathname);
---

<!-- Lives outside the navbar: a transformed parent would trap a fixed backdrop. -->
<button
  type="button"
  tabindex="-1"
  aria-label="Close menu"
  data-nav-backdrop
  data-menu-close
  class="invisible fixed inset-0 z-40 cursor-default bg-black/25 opacity-0 backdrop-blur-[2px] transition-[opacity,visibility] duration-200 data-[open]:visible data-[open]:opacity-100 dark:bg-black/55 md:hidden"
></button>

<div
  data-navbar
  data-fixed={fixed ? "true" : "false"}
  class:list={[
    "group/navbar pointer-events-none z-50",
    fixed ? "navbar-fixed fixed inset-x-0 top-0 px-4 sm:px-6" : "relative",
  ]}
>
  <nav
    aria-label="Main navigation"
    class="nav-glass pointer-events-auto relative mx-auto flex h-14 w-full max-w-5xl items-center justify-between px-6 font-mono"
  >
    <a href="/" class="group inline-flex items-baseline gap-1.5 whitespace-nowrap px-1 py-1 text-[13px]">
      kevin bravo <span class="hidden opacity-60 min-[400px]:inline">aka</span>
      <span class="aka-tag text-[12px]">0bkevin</span>
    </a>

    <ul class="hidden items-center gap-0.5 md:flex">
      {
        NAV_ITEMS.map(({ label, href }) => (
          <li>
            <a
              href={href}
              aria-current={href === active ? "page" : undefined}
              class:list={[
                "rounded-md px-3 py-1.5 text-[13px] lowercase transition-opacity duration-200 motion-reduce:transition-none",
                href === active
                  ? "font-semibold text-accent-500 dark:text-accent-400"
                  : "font-medium opacity-60 hover:opacity-100",
              ]}
            >
              {label}
            </a>
          </li>
        ))
      }
      <li class="ml-1"><ThemeToggle /></li>
    </ul>

    <div class="flex items-center gap-1 md:hidden">
      <ThemeToggle />
      <button
        type="button"
        data-menu-toggle
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="relative flex h-8 w-8 items-center justify-center rounded-md transition-colors hover:bg-black/5 dark:hover:bg-white/[0.06]"
      >
        <span class="relative block h-[14px] w-4" aria-hidden="true">
          <span
            class="absolute left-0 top-1/2 block h-[1.5px] w-4 -translate-y-[5px] rounded-full bg-current transition-transform duration-300 ease-[cubic-bezier(0.65,0,0.35,1)] group-data-[menu-open]/navbar:translate-y-0 group-data-[menu-open]/navbar:rotate-45"
          ></span>
          <span
            class="absolute left-0 top-1/2 block h-[1.5px] w-4 rounded-full bg-current transition-opacity duration-150 group-data-[menu-open]/navbar:opacity-0"
          ></span>
          <span
            class="absolute left-0 top-1/2 block h-[1.5px] w-4 translate-y-[5px] rounded-full bg-current transition-transform duration-300 ease-[cubic-bezier(0.65,0,0.35,1)] group-data-[menu-open]/navbar:translate-y-0 group-data-[menu-open]/navbar:-rotate-45"
          ></span>
        </span>
      </button>
    </div>
  </nav>

  <!-- The fade lives on the glass panel itself: a fading parent would switch its blur off mid-animation. -->
  <div
    id="mobile-menu"
    class="invisible pointer-events-auto absolute inset-x-0 top-[calc(100%+0.5rem)] mx-auto max-w-5xl px-4 font-mono transition-[visibility] duration-200 group-data-[menu-open]/navbar:visible sm:px-6 md:hidden"
  >
    <ul
      class="menu-glass flex -translate-y-2 flex-col rounded-xl p-1.5 opacity-0 transition-[opacity,transform] duration-200 ease-out group-data-[menu-open]/navbar:translate-y-0 group-data-[menu-open]/navbar:opacity-100"
    >
      {
        NAV_ITEMS.map(({ label, href }) => (
          <li>
            <a
              href={href}
              data-menu-close
              aria-current={href === active ? "page" : undefined}
              class:list={[
                "block rounded-md px-4 py-2.5 text-[14px] lowercase transition-opacity duration-200",
                href === active
                  ? "font-semibold text-accent-500 dark:text-accent-400"
                  : "font-medium opacity-60 hover:opacity-100",
              ]}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script>
  import { initNavbar } from "@scripts/navbar";

  initNavbar();
</script>

<style>
  /* Frosted glass: a translucent tint, blur with extra saturation so colors behind stay alive,
     a hairline edge, and a soft top highlight. Shadows stand in for borders so nothing shifts layout. */
  .nav-glass {
    --glass-bg: rgb(255 255 255 / 0.55);
    --glass-edge: rgb(0 0 0 / 0.06);
    --glass-highlight: rgb(255 255 255 / 0.7);
    --glass-shadow: 0 8px 32px -8px rgb(0 0 0 / 0.12);
    border-radius: 1rem;
    background-color: transparent;
    box-shadow: none;
    transition:
      background-color 300ms ease,
      box-shadow 300ms ease,
      backdrop-filter 300ms ease,
      -webkit-backdrop-filter 300ms ease;
  }

  :global(.dark) .nav-glass,
  :global(.dark) .menu-glass {
    --glass-bg: rgb(23 23 23 / 0.5);
    --glass-edge: rgb(255 255 255 / 0.08);
    --glass-highlight: rgb(255 255 255 / 0.06);
    --glass-shadow: 0 8px 32px -8px rgb(0 0 0 / 0.6);
  }

  [data-scrolled] .nav-glass,
  [data-menu-open] .nav-glass,
  .menu-glass {
    background-color: var(--glass-bg);
    box-shadow:
      inset 0 0 0 1px var(--glass-edge),
      inset 0 1px 0 0 var(--glass-highlight),
      var(--glass-shadow);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    backdrop-filter: blur(16px) saturate(180%);
  }

  .menu-glass {
    --glass-bg: rgb(255 255 255 / 0.7);
    --glass-edge: rgb(0 0 0 / 0.06);
    --glass-highlight: rgb(255 255 255 / 0.7);
    --glass-shadow: 0 12px 36px -12px rgb(0 0 0 / 0.16);
  }

  :global(.dark) .menu-glass {
    --glass-bg: rgb(23 23 23 / 0.7);
  }

  /* Browsers without backdrop blur get a solid enough tint to keep links readable. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .nav-glass,
    .menu-glass {
      --glass-bg: rgb(250 250 250 / 0.95);
    }

    :global(.dark) .nav-glass,
    :global(.dark) .menu-glass {
      --glass-bg: rgb(10 10 10 / 0.95);
    }
  }

  /* Slide motion lives here rather than in utilities so "scrolled" and "hidden" never fight over transform. */
  .navbar-fixed {
    transform: translate3d(0, 0, 0);
    transition: transform 480ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .navbar-fixed[data-scrolled] {
    transform: translate3d(0, 1rem, 0);
  }

  /* Clears its own height, the 1rem float offset, and the drop shadow, so nothing peeks in. */
  .navbar-fixed[data-hidden] {
    transform: translate3d(0, calc(-100% - 3rem), 0);
    transition: transform 420ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* The fade sits on the glass bar, not the wrapper: a fading parent switches backdrop blur off. */
  .navbar-fixed .nav-glass {
    transition:
      opacity 220ms ease-out,
      background-color 300ms ease,
      box-shadow 300ms ease,
      backdrop-filter 300ms ease,
      -webkit-backdrop-filter 300ms ease;
  }

  .navbar-fixed[data-hidden] .nav-glass {
    opacity: 0;
    transition:
      opacity 260ms ease-in 120ms,
      background-color 300ms ease,
      box-shadow 300ms ease,
      backdrop-filter 300ms ease,
      -webkit-backdrop-filter 300ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .navbar-fixed,
    .navbar-fixed[data-hidden] {
      transition: none;
    }

    .navbar-fixed .nav-glass,
    .navbar-fixed[data-hidden] .nav-glass {
      transition: opacity 150ms linear;
    }
  }

  .aka-tag {
    padding: 0 0.35em;
    background: color-mix(in oklab, currentColor 8%, transparent);
    box-shadow: 2px 2px 0 #ca8a04;
    transition: box-shadow 200ms ease;
  }

  :global(.dark) .aka-tag {
    box-shadow: 2px 2px 0 #facc15;
  }

  @media (hover: hover) {
    a:hover .aka-tag {
      box-shadow: 3px 3px 0 #ca8a04;
    }

    :global(.dark) a:hover .aka-tag {
      box-shadow: 3px 3px 0 #facc15;
    }
  }
</style>
