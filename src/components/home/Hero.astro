---
import Icon from "@components/ui/Icon.astro";
import { CV_URL, PROFILE_LINKS } from "@data/profile";
---

<section id="home" class="home-col flex flex-col justify-center pb-12 pt-10 sm:min-h-[100svh] sm:pb-24 sm:pt-24 md:pb-32 md:pt-28">
  <h1
    class="fade-in-up text-[2.75rem] font-extrabold leading-[1.05] tracking-tight text-accent-500 dark:text-accent-400 sm:text-7xl md:text-8xl"
    style="--d: 0ms"
  >
    Kevin Bravo
  </h1>

  <p class="fade-in-up mt-3 font-mono text-[13px] sm:mt-5 sm:text-sm" style="--d: 80ms">
    <span class="text-surface-800 dark:text-surface-200">product &amp; ai engineer</span>
    <span class="text-surface-500"> · full-stack</span>
  </p>

  <p
    class="fade-in-up mt-6 max-w-2xl text-base font-normal leading-relaxed sm:mt-8 sm:text-lg text-surface-700 dark:text-surface-300 md:text-xl md:font-light"
    style="--d: 160ms"
  >
    <span class="sm:hidden">
      Product and AI engineer with 5+ years turning ideas into real products. These days I spend most of my time on AI
      agents, building them and the infrastructure and tooling that keep them reliable.
    </span>
    <span class="hidden sm:inline">
      I build products end to end and keep owning them after launch. For 5+ years I've worked with people to figure out
      what's worth building, then designed, coded, deployed, and supported it, whether on my own or leading a team.
      Most recently a senior product engineer at Free2Z, building AI agents and the RAG, evals, and tooling that make
      them reliable. Into maths, cryptography, security, and embedded systems. MPA student at IESA, based in Caracas.
    </span>
  </p>

  <div class="fade-in-up mt-8 flex flex-wrap items-center gap-2 sm:mt-10 sm:gap-4" style="--d: 240ms">
    <a
      href="/contact"
      class="inline-flex items-center gap-2 rounded-lg bg-surface-900 px-4 py-3 font-mono text-[13px] lowercase text-white transition-colors hover:bg-surface-800 dark:bg-surface-100 dark:text-surface-900 dark:hover:bg-surface-200 sm:px-6"
    >
      Get in touch
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
    </a>
    <a
      href="/projects"
      class="inline-flex items-center gap-2 rounded-lg border border-surface-200 px-4 py-3 font-mono text-[13px] lowercase text-surface-600 transition-colors hover:border-surface-300 hover:text-surface-900 dark:border-surface-800 dark:text-surface-400 dark:hover:border-surface-700 dark:hover:text-surface-200 sm:px-6"
    >
      Explore my work
    </a>
  </div>

  <div class="fade-in-up mt-8 flex flex-wrap items-center gap-x-8 gap-y-4 sm:mt-12" style="--d: 320ms">
    <ul class="flex items-center gap-6" aria-label="Social profiles">
      {
        PROFILE_LINKS.map(({ label, href, icon }) => (
          <li>
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={label}
              class="block text-surface-500 transition-all duration-300 hover:-translate-y-0.5 hover:text-surface-900 dark:hover:text-surface-100"
            >
              <Icon name={icon} class="h-5 w-5" />
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href={CV_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 font-mono text-[13px] lowercase text-surface-500 transition-colors hover:text-surface-900 dark:text-surface-400 dark:hover:text-surface-100"
    >
      Download CV
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"></path><path d="m7 10 5 5 5-5"></path><path d="M5 21h14"></path></svg>
    </a>
  </div>
</section>
