---
import Icon from "@components/ui/Icon.astro";
import SectionHeading from "@components/layout/SectionHeading.astro";
import { HONORS, type Honor } from "@data/honors";

const grouped = HONORS.reduce<Record<string, Honor[]>>((acc, honor) => {
  const year = new Date(honor.date).getFullYear().toString();
  (acc[year] ??= []).push(honor);
  return acc;
}, {});

const years = Object.keys(grouped).sort((a, b) => Number(b) - Number(a));

const monthOf = (date: string) =>
  new Date(date).toLocaleString("en-US", { month: "long" });
---

<section class="home-col py-10 sm:py-14 md:py-20" id="honors">
  <div class="mb-6 md:mb-10">
    <SectionHeading num="04" label="Prizes" />
    <h2 class="section-title">Recognitions</h2>
  </div>

  <div class="flex flex-col gap-8 md:gap-10">
    {
      years.map((year) => (
        <div class="relative">
          <span
            aria-hidden="true"
            class="ghost-year block font-bold tracking-tighter leading-[0.85] select-none pointer-events-none text-[clamp(3.5rem,11vw,7rem)]"
          >
            {year}
          </span>

          <div class="relative -mt-4 md:-mt-6 flex flex-col gap-8 md:gap-10 pl-1 md:pl-2">
            {(grouped[year] ?? []).map((honor) => (
              <article class="group max-w-2xl">
                <a
                  href={honor.proof}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block"
                >
                  <p class="mb-2 text-[10px] font-semibold uppercase tracking-[0.25em] text-surface-500">
                    {honor.issuer}{" "}
                    <span class="text-surface-300 dark:text-surface-700">·</span>{" "}
                    {monthOf(honor.date)}
                  </p>

                  <h3 class="inline-flex items-baseline gap-3 text-xl md:text-2xl font-semibold tracking-tight text-surface-900 dark:text-surface-100 transition-colors group-hover:text-accent-600 dark:group-hover:text-accent-400">
                    <span>{honor.title}</span>
                    <Icon
                      name="external-link"
                      class="h-4 w-4 shrink-0 -translate-x-1 self-center text-surface-300 opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:text-accent-500 group-hover:opacity-100 dark:text-surface-700"
                    />
                  </h3>

                  <p class="mt-3 text-sm leading-relaxed text-surface-600 dark:text-surface-400">
                    {honor.summary}
                  </p>
                </a>
              </article>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .ghost-year {
    color: transparent;
    -webkit-text-stroke: 1.5px #e5e5e5;
  }

  :global(.dark) .ghost-year {
    -webkit-text-stroke: 1.5px #262626;
  }
</style>
