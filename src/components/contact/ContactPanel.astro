---
// Contact details and the form, shared by the homepage section and /contact.
import { contactData } from "./form/contactData";
import ContactForm from "./form/ContactForm.svelte";

interface Props {
  /** Show the short "inbox is open" line; pages with their own intro turn it off. */
  showIntro?: boolean;
}

const { showIntro = true } = Astro.props;

const primary = contactData.find((c) => c.title === "Email");
const others = contactData.filter((c) => c.title !== "Email");

const ICON_CLASS =
  "text-surface-500 transition-colors group-hover:text-accent-500 dark:group-hover:text-accent-400";

const DISCORD_PATH =
  "M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z";

const X_PATH =
  "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z";
---

<div class="grid items-start gap-10 lg:grid-cols-[1fr_1.3fr] lg:gap-16">
  <div class="flex flex-col gap-8 md:gap-12">
    {
      showIntro && (
        <p class="max-w-sm text-sm leading-relaxed text-surface-600 dark:text-surface-400 md:text-[15px]">
          Have a project or a question? My inbox is open, and I usually reply within a day.
        </p>
      )
    }

    {
      primary && (
        <a href={primary.link} class="group inline-flex w-fit items-baseline gap-2.5">
          <span class="font-mono text-base text-surface-900 transition-colors group-hover:text-accent-600 dark:text-surface-100 dark:group-hover:text-accent-400 md:text-lg">
            {primary.content}
          </span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-surface-500 transition-all duration-300 group-hover:translate-x-1 group-hover:text-accent-500 dark:text-surface-500" aria-hidden="true">
            <path d="m5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </a>
      )
    }

    <ul class="flex flex-col gap-3">
      {
        others.map((info) => {
          const icon =
            info.title === "Discord" ? (
              <svg viewBox="0 0 24 24" fill="currentColor" class={`h-4 w-4 ${ICON_CLASS}`} aria-hidden="true">
                <path d={DISCORD_PATH} />
              </svg>
            ) : info.title === "X" ? (
              <svg viewBox="0 0 24 24" fill="currentColor" class={`h-3.5 w-4 ${ICON_CLASS}`} aria-hidden="true">
                <path d={X_PATH} />
              </svg>
            ) : (
              <i class={`bx bx${info.icon} text-base ${ICON_CLASS}`} aria-hidden="true" />
            );
          const label = (
            <span class="font-mono text-[13px] lowercase text-surface-500 transition-colors group-hover:text-surface-900 dark:group-hover:text-surface-100">
              {info.title}
            </span>
          );
          const value = (
            <span class="font-mono text-[13px] text-surface-700 transition-colors group-hover:text-surface-900 dark:text-surface-300 dark:group-hover:text-surface-100">
              {info.content}
            </span>
          );
          return (
            <li>
              {"copy" in info ? (
                <button
                  type="button"
                  class="contact-copy group inline-flex w-fit items-center gap-3.5 text-left"
                  data-copy={info.content}
                  aria-label={`Copy ${info.title} username ${info.content}`}
                >
                  {icon}
                  {label}
                  {value}
                  <span class="contact-copy-status font-mono text-[12px] lowercase text-accent-500 dark:text-accent-400" aria-live="polite">copy</span>
                </button>
              ) : (
                <a href={info.link} target="_blank" rel="noopener noreferrer" class="group inline-flex w-fit items-center gap-3.5">
                  {icon}
                  {label}
                  {value}
                </a>
              )}
            </li>
          );
        })
      }
    </ul>
  </div>

  <ContactForm client:only="svelte" />
</div>

<script>
  // Copy a handle (Discord has no profile URL for usernames) and confirm in place.
  document.addEventListener("click", async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".contact-copy");
    if (!button) return;
    const status = button.querySelector(".contact-copy-status");
    try {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
      if (status) status.textContent = "copied";
    } catch {
      if (status) status.textContent = "copy failed";
    }
    window.setTimeout(() => {
      if (status) status.textContent = "copy";
    }, 1800);
  });
</script>
