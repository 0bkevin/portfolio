---
import Layout from "@layouts/Layout.astro";

// Prerendered so the build emits a top-level 404.html. Without one, Cloudflare Pages treats the
// site as a single-page app and answers every unknown URL with the homepage and a 200 status,
// which search engines index as soft 404s. Trailing-slash URLs still redirect first: Pages sends
// /experience/ to /experience before any 404 handling, and the middleware covers server routes.
export const prerender = true;

const pageTitle = "Page not found | Kevin Bravo";
const pageDescription = "This page doesn't exist or has moved.";
---

<Layout title={pageTitle} description={pageDescription} noindex>
  <section class="home-col flex min-h-[calc(100svh-3.5rem)] flex-col justify-center pb-24 pt-10">
    <p class="page-label fade-in-up" style="--d: 0ms">
      <span class="section-num" aria-hidden="true">//</span> error · not found
    </p>

    <h1 class="fade-in-up" style="--d: 60ms">
      <span
        class="block font-mono text-[5.5rem] font-bold leading-none tracking-tighter text-accent-500 dark:text-accent-400 sm:text-[9rem] md:text-[11rem]"
        aria-hidden="true">404</span
      >
      <span class="mt-4 block text-3xl font-bold tracking-tight text-surface-900 dark:text-surface-100 sm:mt-6 md:text-4xl">
        This page doesn't exist.
      </span>
    </h1>

    <p
      class="fade-in-up mt-5 max-w-xl text-base leading-relaxed text-surface-600 dark:text-surface-400 md:text-lg"
      style="--d: 120ms"
    >
      The link may be broken, or the page may have moved.
    </p>

    <a
      href="/"
      class="fade-in-up group mt-10 inline-flex w-fit items-center gap-1.5 font-mono text-[13px] lowercase text-accent-500 dark:text-accent-400"
      style="--d: 180ms"
    >
      <span class="transition-transform group-hover:-translate-x-0.5" aria-hidden="true">←</span>
      back home
    </a>
  </section>
</Layout>
