---
import Layout from "@layouts/Layout.astro";
import Hero from "@components/home/Hero.astro";
import About from "@components/home/About.astro";
import ExperienceSection from "@components/home/ExperienceSection.astro";
import ScrollUp from "@components/layout/ScrollUp.astro";
import ContactSection from "@components/home/ContactSection.astro";
import ProjectsSection from "@components/home/ProjectsSection.astro";
import BlogSection from "@components/home/BlogSection.astro";
import AchievementsSection from "@components/home/AchievementsSection.astro";
import TalksSection from "@components/home/TalksSection.astro";
import { createProfilePageSchema, createWebsiteSchema, seoConfig } from "@lib/seo";

// Static HTML served from the edge cache; nothing here depends on the request.
export const prerender = true;

const title = "Kevin Bravo | Product & AI Engineer";
const description =
  "Kevin Bravo is a product and AI engineer in Caracas, Venezuela. Case studies, projects, talks, and writing on full-stack products, AI agents, MCP, and backend systems.";
const image = seoConfig.defaultOgImage;

// The homepage is Kevin's entity home: a ProfilePage whose main entity is the full Person definition.
// The WebSite node here is what Google reads for the site name.
const profilePageSchema = createProfilePageSchema({
  name: title,
  description,
  url: `${seoConfig.siteUrl}/`,
  // Update dateModified when the profile content on this page changes.
  dateCreated: "2024-09-11",
  dateModified: "2026-11-10",
});

const structuredData = [createWebsiteSchema(), profilePageSchema];
---

<Layout
  title={title}
  description={description}
  image={image}
  imageAlt={seoConfig.defaultOgImageAlt}
  canonical="/"
  type="website"
  structuredData={structuredData}
>
  <Hero />
  <ExperienceSection />
  <About />
  <ProjectsSection />
  <AchievementsSection />
  <TalksSection />
  <BlogSection />
  <ContactSection />
  <ScrollUp />
</Layout>
