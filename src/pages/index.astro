---
import Layout from "../layouts/Layout.astro";
import Home from "../components/home/Home.astro";
import About from "../components/about/About.astro";
import ExperienceSection from "../components/experience/ExperienceSection.astro";
import ScrollUp from "../components/ScrollUp.astro";
import Contact from "../components/contact/Contact.astro";
import ProjectsSection from "../components/projects/section/ProjectsSection.astro";
import BlogSection from "../components/blog/section/BlogSection.astro";
import AchievementsSection from "../components/achievements/AchievementsSection.astro";
import TalksSection from "../components/talks/TalksSection.astro";
import { createPersonSchema, createProfilePageSchema, createWebsiteSchema, seoConfig } from "@lib/seo";

const title = "Kevin Bravo | Product & AI Engineer";
const description =
  "Kevin Bravo is a product and AI engineer in Caracas, Venezuela. Case studies, projects, talks, and writing on full-stack products, AI agents, MCP, and backend systems.";
const image = seoConfig.defaultOgImage;

// The homepage is Kevin's entity home: a ProfilePage whose main entity is the one Person definition.
const profilePageSchema = createProfilePageSchema({
  name: title,
  description,
  url: `${seoConfig.siteUrl}/`,
  // Update dateModified when the profile content on this page changes.
  dateCreated: "2024-09-11",
  dateModified: "2026-11-10",
});

const websiteSchema = createWebsiteSchema();
const personSchema = createPersonSchema();

const structuredData = [websiteSchema, personSchema, profilePageSchema];
---

<Layout
  title={title}
  description={description}
  image={image}
  imageAlt={seoConfig.defaultOgImageAlt}
  canonical="/"
  type="website"
  structuredData={structuredData}
>
  <Home />
  <ExperienceSection />
  <About />
  <ProjectsSection />
  <AchievementsSection />
  <TalksSection />
  <BlogSection />
  <Contact />
  <ScrollUp />
</Layout>
