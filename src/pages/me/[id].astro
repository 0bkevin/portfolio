---
import BlogLayout from "@layouts/Blog.astro";
import { type CollectionEntry, getCollection, render } from "astro:content";
import { createBreadcrumbSchema, createPersonSchema, createProfilePageSchema } from "@lib/seo";

export const prerender = true;

// called at build time, it compiles the list of all possible paths for this page to make it static
export async function getStaticPaths() {
  const posts = (await getCollection("me")) as CollectionEntry<"me">[];

  return posts.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"me">;
}

const { entry } = Astro.props as Props;
const { Content, headings } = await render(entry);

const pathname = `/me/${entry.id}`;
const pageUrl = new URL(pathname, Astro.site).toString();
const updatedDate = entry.data.updateDate ?? entry.data.pubDate;
const { seoTitle, seoDescription } = entry.data;

const breadcrumbSchema = createBreadcrumbSchema([
  { name: "Home", item: "/" },
  { name: entry.data.title, item: pathname },
]);

const profilePageSchema = createProfilePageSchema({
  name: seoTitle || entry.data.title,
  description: seoDescription || entry.data.description,
  url: pageUrl,
  dateCreated: entry.data.pubDate,
  dateModified: updatedDate,
});

const structuredData = [profilePageSchema, createPersonSchema(), breadcrumbSchema];
---

<BlogLayout
  entry={entry}
  tableOfContents={headings}
  backHref="/"
  backLabel="Home"
  showAuthor={true}
  sectionLabel={entry.id === "ama" ? "me · ask me anything" : "me · about"}
  seoTitle={seoTitle}
  seoDescription={seoDescription}
  type="profile"
  canonical={pathname}
  structuredData={structuredData}
  hideSectionLabel={false}
>
  <Content />
</BlogLayout>
